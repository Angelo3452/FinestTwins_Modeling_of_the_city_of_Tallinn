#missing_origins<-as.integer(missing_origins)
#wt[which(wt$origins %in% missing_origins),"name"]<-3600 # 1 h delay to the ones not served within the hour in fully inserved centroids
wt[which(is.na(wt$name) == TRUE),"name"]<-mean(wt$name, na.rm=TRUE)
## but we have 610 garages, wherever there were no requests we can keep an estimate of 10 minutes as waiting times, for the next round of iterations
sink('/home/angelo/PycharmProjects/AV/Data/am_wtgarages.txt')
cat(as.character(mean(wt$name, na.rm=TRUE)))
sink()
req_fin_avg$name<-as.integer(req_fin_avg$name)
